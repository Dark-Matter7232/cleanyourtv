<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/assistant_disabled_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="46dp"
        android:paddingTop="38dp"
        android:paddingEnd="46dp"
        android:paddingBottom="34dp"
        android:background="@drawable/glass_panel"
        android:elevation="12dp">

        <ImageView
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:contentDescription="@string/assistant_disabled_title"
            android:src="@drawable/ic_assistant_disabled"
            android:tint="#D9FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/assistant_disabled_title"
            android:textColor="#FFFFFFFF"
            android:textSize="27sp"
            android:fontFamily="@string/font_medium"
            android:gravity="center"
            android:includeFontPadding="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/assistant_disabled_title_hi"
            android:textColor="#E6FFFFFF"
            android:textSize="24sp"
            android:fontFamily="@string/font_medium"
            android:gravity="center"
            android:includeFontPadding="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/assistant_disabled_hint"
            android:textColor="#99FFFFFF"
            android:textSize="15sp"
            android:fontFamily="@string/font_light"
            android:gravity="center"
            android:includeFontPadding="false" />

    </LinearLayout>
</FrameLayout>
